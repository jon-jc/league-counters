# Copy to .env.local and fill in.

# Riot Games API key — https://developer.riotgames.com/
# Development keys expire every 24 hours and are rate limited to
# 20 requests / 1s and 100 requests / 2min.
RIOT_API_KEY=

# Shared secret required by the /api/cron/ingest endpoint.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Public site origin, used for canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
